{
  "name": "oppscout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed/index.ts",
    "worker:notifications": "tsx scripts/worker/notifications.ts",
    "worker:freshness": "tsx scripts/worker/freshness.ts",
    "verify": "npm run prisma:validate && npm run typecheck && npm run test && npm run build && npm run check:stubs",
    "check:stubs": "node scripts/check-phase-one-stubs.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.112.3",
    "next": "15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.4.21",
    "es-abstract": "^1.24.2",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.23",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "prisma": "6.19.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "prisma": {
    "seed": "tsx scripts/seed/index.ts"
  }
}
