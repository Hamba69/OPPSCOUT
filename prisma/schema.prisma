generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PreferredChannel {
  web
  email
  sms
  ussd
}

enum WorkMode {
  remote
  onsite
  hybrid
  unknown
}

enum VerificationStatus {
  unverified
  pending
  verified
  flagged
}

enum OpportunitySource {
  org_submitted
  scraped
  partner_feed
}

enum OpportunityOrigin {
  catalog
  organization
}

enum OpportunityStatus {
  open
  closing_soon
  closed
  stale
  removed
}

enum GeneratedBy {
  rules
  ai
}

enum NotificationChannelType {
  email
  sms
  ussd
  app
}

enum NotificationStatus {
  sent
  delivered
  failed
}

enum NotificationFrequency {
  instant
  daily
  weekly
}

enum SubscriptionTier {
  free
  growth
  partner
}

enum SubscriptionStatus {
  inactive
  trial
  active
  past_due
  cancelled
}

enum SavedOpportunityStatus {
  saved
  applied
  expired
}

enum EventType {
  view
  save
  click
  apply_intent
  report
}

enum ApplicantScope {
  uganda_residents
  ugandan_citizens
  african_nationals
  global
}

enum RemoteEligibility {
  unknown
  uganda
  east_africa
  africa
  global
}

enum ProvenanceType {
  official_page
  application_system
  org_attested
}

enum SourceKind {
  api
  careers_page
  rss
  newspaper
  partner
  community
}

enum SourceStatus {
  proposed
  approved
  paused
  blocked
}

enum LeadChannel {
  whatsapp
  tiktok
  instagram
  facebook
  linkedin
  newspaper
  web
  email
  employer
  other
}

enum LeadStatus {
  new
  tracing
  traced
  rejected
  duplicate
  promoted
  expired
}

enum ReportStatus {
  open
  actioned
  dismissed
}

model UserProfile {
  id                       String                @id @db.Uuid
  name                     String
  countryOfResidence       String                @default("UG")
  openToAbroad             Boolean               @default(false)
  phone                    String?               @unique
  email                    String?               @unique
  preferredChannel         PreferredChannel      @default(web)
  secondaryChannels        PreferredChannel[]    @default([])
  notificationsEnabled     Boolean               @default(true)
  notificationFrequency    NotificationFrequency @default(instant)
  educationLevel           String?
  institution              String?
  fieldOfStudy             String?
  graduationStatus         String?
  dateOfBirth              DateTime?             @db.Date
  skills                   String[]              @default([])
  workExperience           Json                  @default("[]")
  internshipExperience     Json                  @default("[]")
  certifications           String[]              @default([])
  location                 String?
  preferredLocations       String[]              @default([])
  careerInterests          String[]              @default([])
  opportunityCategories    String[]              @default([])
  workModePreference       WorkMode?
  languages                String[]              @default([])
  githubUrl                String?
  portfolioUrl             String?
  otherLinks               Json                  @default("[]")
  projects                 Json                  @default("[]")
  shareWithOrganizations   Boolean               @default(false)
  shareContactDetails      Boolean               @default(false)
  orgSharingConsentAt      DateTime?
  orgSharingConsentVersion String?
  profileCompletenessScore Int                   @default(0)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  feedback                 Feedback[]
  matchRuns                MatchRun[]
  matches                  MatchResult[]
  notifications            Notification[]
  savedOpportunities       SavedOpportunity[]
  events                   EventLog[]
  submittedLeads           Lead[]
  listingReports           ListingReport[]

  @@index([preferredChannel])
}

model Organization {
  id                     String             @id @default(uuid()) @db.Uuid
  name                   String
  sector                 String
  officialLinks          String[]           @default([])
  officialDomains        String[]           @default([])
  trustedPoster          Boolean            @default(false)
  verifiedAt             DateTime?
  verifiedBy             String?
  officialEmail          String?
  registrationProof      String?
  accountableContact     String?
  verificationStatus     VerificationStatus @default(unverified)
  dashboardUsers         String[]           @default([])
  postingHistory         Json               @default("[]")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  subscriptionTier       SubscriptionTier   @default(free)
  subscriptionStatus     SubscriptionStatus @default(inactive)
  monetizationEnabled    Boolean            @default(false)
  promotedListingCredits Int                @default(0)
  promotionPolicy        Json               @default("{}")
  opportunities          Opportunity[]
  sources                Source[]
  leads                  Lead[]

  @@index([verificationStatus])
}

model Opportunity {
  id                 String             @id @default(uuid()) @db.Uuid
  title              String
  organizationId     String?            @db.Uuid
  organizationName   String?
  category           String
  description        String
  eligibility        Json
  requiredSkills     String[]           @default([])
  preferredSkills    String[]           @default([])
  location           String
  workMode           WorkMode
  deadline           DateTime?
  applicationMethod  String
  sourceUrl          String
  verificationStatus VerificationStatus @default(pending)
  source             OpportunitySource  @default(org_submitted)
  origin             OpportunityOrigin  @default(catalog)
  publicationDate    DateTime           @default(now())
  checkedAt          DateTime           @default(now())
  status             OpportunityStatus  @default(open)
  reviewChecklist    Json               @default("{}")
  reviewNotes        String?
  reviewerId         String?
  reviewedAt         DateTime?
  audience           ApplicantScope?
  countryCodes       String[]           @default([])
  regions            String[]           @default([])
  remoteEligibility  RemoteEligibility  @default(unknown)
  eligibleCountries  String[]           @default([])
  provenanceType     ProvenanceType?
  sourceId           String?            @db.Uuid
  leadId             String?            @unique @db.Uuid
  canonicalUrl       String?
  contentHash        String?
  deadlineDateOnly   Boolean            @default(false)
  lastSeenAt         DateTime?
  needsRecheck       Boolean            @default(false)
  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceRecord       Source?            @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  promotedLead       Lead?              @relation("LeadOpportunity", fields: [leadId], references: [id], onDelete: SetNull)
  promotedFromLead   Lead?              @relation("LeadPromotion")
  matches            MatchResult[]
  savedBy            SavedOpportunity[]
  events             EventLog[]
  listingReports     ListingReport[]

  @@index([verificationStatus, status, deadline])
  @@index([organizationId, title, deadline])
  @@index([audience, status])
  @@index([canonicalUrl])
  @@index([organizationId, status])
}

model MatchResult {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  opportunityId  String         @db.Uuid
  score          Int
  matchedFactors Json
  missingFactors Json
  generatedBy    GeneratedBy    @default(rules)
  createdAt      DateTime       @default(now())
  user           UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity    Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  notifications  Notification[]

  @@unique([userId, opportunityId])
  @@index([userId, score])
}

model Notification {
  id          String                  @id @default(uuid()) @db.Uuid
  userId      String                  @db.Uuid
  matchId     String?                 @db.Uuid
  channel     NotificationChannelType
  status      NotificationStatus
  triggerKey  String
  message     String
  sentAt      DateTime                @default(now())
  deliveredAt DateTime?
  user        UserProfile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  match       MatchResult?            @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([userId, sentAt])
  @@index([userId, triggerKey, sentAt])
}

model SavedOpportunity {
  id            String                 @id @default(uuid()) @db.Uuid
  userId        String                 @db.Uuid
  opportunityId String                 @db.Uuid
  status        SavedOpportunityStatus @default(saved)
  reminderSent  Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  user          UserProfile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity            @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId, status])
}

model EventLog {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     EventType
  userId        String?      @db.Uuid
  opportunityId String?      @db.Uuid
  timestamp     DateTime     @default(now())
  metadata      Json         @default("{}")
  user          UserProfile? @relation(fields: [userId], references: [id], onDelete: SetNull)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([eventType, timestamp])
  @@index([userId, timestamp])
}

enum FeedbackCategory {
  idea
  bug
  matching_quality
  speed
  other
}

enum FeedbackStatus {
  new
  reviewed
  planned
  shipped
  dismissed
}

enum DeviceClass {
  mobile
  tablet
  desktop
}

enum RequestKind {
  api
  ussd
}

enum VitalMetric {
  LCP
  INP
  CLS
  FCP
  TTFB
}

enum VitalRating {
  good
  needs_improvement @map("needs-improvement")
  poor
}

enum MatchRunEngine {
  orbit
  rules
  ai
}

enum MatchRunTrigger {
  feed
  profile_update
  notification_run
  api
}

enum UnmatchedKind {
  skill
  field
  location
  interest
}

enum AdminAccessEvent {
  unlock_success
  unlock_failure
  export
  feedback_update
}

enum StoredDocumentOwnerType {
  user
  organization
}

enum StoredDocumentPurpose {
  research_paper
  registration_proof
}

enum StoredDocumentStatus {
  pending
  ready
  rejected
}

enum SeekerAccessAction {
  view_card
  view_profile
  download_document
}

enum SeekerPipelineStage {
  new
  shortlisted
  invited
  contacted
  not_a_fit
}

model StoredDocument {
  id                     String                  @id @default(uuid()) @db.Uuid
  ownerType              StoredDocumentOwnerType
  ownerId                String                  @db.Uuid
  purpose                StoredDocumentPurpose
  title                  String
  description            String?
  originalFileName       String
  storagePath            String                  @unique
  mimeType               String
  sizeBytes              Int
  sha256                 String?
  status                 StoredDocumentStatus    @default(pending)
  shareWithOrganizations Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([ownerType, ownerId, purpose])
}

model SeekerAccessLog {
  id             String             @id @default(uuid()) @db.Uuid
  createdAt      DateTime           @default(now())
  organizationId String             @db.Uuid
  seekerId       String             @db.Uuid
  opportunityId  String?            @db.Uuid
  action         SeekerAccessAction
  documentId     String?            @db.Uuid

  @@index([seekerId, createdAt])
  @@index([organizationId, createdAt])
}

model SeekerPipelineEntry {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  opportunityId  String              @db.Uuid
  seekerId       String              @db.Uuid
  stage          SeekerPipelineStage @default(new)
  note           String?
  invitedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, opportunityId, seekerId])
  @@index([organizationId, opportunityId, stage])
}

model Feedback {
  id           String           @id @default(uuid()) @db.Uuid
  createdAt    DateTime         @default(now())
  category     FeedbackCategory
  rating       Int
  message      String
  contactEmail String?
  userId       String?          @db.Uuid
  user         UserProfile?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitorHash  String           @unique
  ipHash       String
  deviceClass  DeviceClass
  appVersion   String?
  status       FeedbackStatus   @default(new)
  adminNote    String?
  updatedAt    DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([ipHash, createdAt])
}

model RequestMetric {
  id         String      @id @default(uuid()) @db.Uuid
  createdAt  DateTime    @default(now())
  kind       RequestKind
  route      String
  method     String
  status     Int
  ok         Boolean
  durationMs Int

  @@index([createdAt])
  @@index([route, createdAt])
}

model WebVitalSample {
  id          String      @id @default(uuid()) @db.Uuid
  createdAt   DateTime    @default(now())
  route       String
  metric      VitalMetric
  value       Float
  rating      VitalRating
  deviceClass DeviceClass

  @@index([metric, createdAt])
  @@index([route, metric])
  @@index([createdAt])
}

model MatchRun {
  id                   String          @id @default(uuid()) @db.Uuid
  createdAt            DateTime        @default(now())
  userId               String?         @db.Uuid
  user                 UserProfile?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  engine               MatchRunEngine
  engineVersion        String
  trigger              MatchRunTrigger
  durationMs           Int
  candidatesConsidered Int
  gateExcluded         Int
  scored               Int
  aboveThreshold       Int
  topScore             Int?
  scoreHistogram       Json
  gateExclusionReasons Json
  topMissingFactors    Json

  @@index([createdAt])
  @@index([engine, createdAt])
}

model UnmatchedTerm {
  id          String        @id @default(uuid()) @db.Uuid
  kind        UnmatchedKind
  term        String        @db.VarChar(80)
  count       Int           @default(1)
  firstSeenAt DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())

  @@unique([kind, term])
}

model AdminAccessLog {
  id        String           @id @default(uuid()) @db.Uuid
  createdAt DateTime         @default(now())
  event     AdminAccessEvent
  ipHash    String
  userAgent String           @db.VarChar(200)
  detail    Json

  @@index([createdAt])
}

model MetricRollup {
  id        String   @id @default(uuid()) @db.Uuid
  day       DateTime @db.Date
  metric    String
  dimension String
  value     Float
  samples   Int

  @@unique([day, metric, dimension])
}

model Source {
  id                  String      @id @default(uuid()) @db.Uuid
  name                String
  kind                SourceKind
  baseUrl             String      @unique
  organizationId      String?     @db.Uuid
  status              SourceStatus @default(proposed)
  termsReviewedAt     DateTime?
  termsNotes          String?
  crawlIntervalHours  Int         @default(24)
  lastRunAt           DateTime?
  lastSuccessAt       DateTime?
  consecutiveFailures Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  leads               Lead[]
  opportunities       Opportunity[]
  ingestionRuns       IngestionRun[]

  @@index([status, lastRunAt])
  @@index([organizationId])
}

model Lead {
  id                    String      @id @default(uuid()) @db.Uuid
  channel               LeadChannel
  status                LeadStatus  @default(new)
  sourceId              String?     @db.Uuid
  submittedById         String?     @db.Uuid
  rawUrl                String?
  canonicalUrl          String?
  screenshotPath        String?
  note                  String?
  extracted             Json        @default("{}")
  candidateOrgName      String?
  officialUrl           String?
  organizationId        String?     @db.Uuid
  fingerprint           String      @unique
  duplicateOfId         String?     @db.Uuid
  promotedOpportunityId String?     @unique @db.Uuid
  rejectReason          String?
  createdAt             DateTime    @default(now())
  tracedAt              DateTime?
  resolvedAt            DateTime?
  source                Source?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  submittedBy           UserProfile? @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  organization          Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  duplicateOf           Lead?       @relation("LeadDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates            Lead[]      @relation("LeadDuplicates")
  promotedOpportunity   Opportunity? @relation("LeadPromotion", fields: [promotedOpportunityId], references: [id], onDelete: SetNull)
  promotedAsOpportunity Opportunity? @relation("LeadOpportunity")

  @@index([status, createdAt])
  @@index([canonicalUrl])
  @@index([submittedById, status])
  @@index([sourceId, createdAt])
  @@index([organizationId, status])
}

model ListingReport {
  id             String       @id @default(uuid()) @db.Uuid
  opportunityId  String       @db.Uuid
  reporterId     String?      @db.Uuid
  reason         String
  details        String?
  status         ReportStatus @default(open)
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?
  resolutionNote String?
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  reporter       UserProfile? @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@unique([opportunityId, reporterId])
  @@index([status, createdAt])
  @@index([opportunityId])
}

model IngestionRun {
  id         String    @id @default(uuid()) @db.Uuid
  sourceId   String    @db.Uuid
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  fetched    Int       @default(0)
  created    Int       @default(0)
  updated    Int       @default(0)
  duplicates Int       @default(0)
  failed     Int       @default(0)
  errors     Json      @default("[]")
  source     Source    @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([sourceId, startedAt])
}
