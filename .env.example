# Runtime database: Supabase transaction pooler on port 6543 with PgBouncer enabled and a low connection limit.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Migration and introspection only: Supabase direct connection on port 5432, never used by the app runtime.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# Public app URL used for email links and callback URLs.
OPPSCOUT_APP_URL="http://127.0.0.1:3000"

# Prisma is the only runtime data adapter. Tests inject an in-memory repository separately.
OPPSCOUT_DATA_MODE="prisma"

# Supabase Auth configuration.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend and notification delivery.
RESEND_API_KEY=""
OPPSCOUT_EMAIL_FROM="OppScout <alerts@example.com>"
NOTIFICATION_DAILY_CAP="3"

# Africa's Talking / USSD.
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USSD_WEBHOOK_SECRET=""
OPPSCOUT_USSD_ALLOW_QUERY_SECRET="false"
USSD_TOKEN_SECRET=""

# Redis / rate limiting.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_USER_PER_MINUTE="120"
RATE_LIMIT_ORGANIZATION_PER_MINUTE="240"
RATE_LIMIT_ADMIN_PER_MINUTE="360"
RATE_LIMIT_USSD_PER_MINUTE="60"

# AI and matching.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
OPPSCOUT_AI_DEFAULT="false"
OPPSCOUT_AI_COMPARISON_APPROVED="false"
OPPSCOUT_SCRAPER_SHADOW_BUCKET="oppscout-scraper-shadow"

# Monetization and governance gates.
OPPSCOUT_MONETIZATION_LEGAL_REVIEW=""
OPPSCOUT_MIN_ORG_RETENTION_PERCENT=""
OPPSCOUT_MAX_TRUST_TURNAROUND_HOURS=""
OPPSCOUT_MIN_ORG_SAMPLE=""

# Optional production safety settings.
OPPSCOUT_APP_ENV=""
